{
  "expo": {
    "name": "Ikigai Connect",
    "slug": "ikigai-connect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logo-new.png",
    "scheme": "ikigaiconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ikigaiconnect.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/logo-new.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ikigaiconnect.app",
      "versionCode": 1
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/logo-new.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/logo-new.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dfd572be-77a8-40ca-91c5-e053adbb0e99"
      }
    },
    "owner": "prakashbidar"
  }
}
